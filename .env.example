# --- Backend (Neon Postgres) ---
# Create a free project at https://neon.tech, then paste the pooled connection string.
# Example: postgresql://user:password@ep-xxx-xxx.ap-southeast-1.aws.neon.tech/sunset-lagoon?sslmode=require
DATABASE_URL=

# Optional: secret used to sign admin session tokens.
# If omitted, a stable secret is derived from DATABASE_URL automatically.
ADMIN_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
# Inbox for booking + contact notifications (defaults to sunsetlagoon.boats@gmail.com if omitted)
ADMIN_NOTIFICATION_EMAIL=sunsetlagoon.boats@gmail.com
# Sender address (domain must be verified in Resend).
# Until verified, you can temporarily use onboarding@resend.dev to test admin alerts.
EMAIL_FROM=Sunset Lagoon <bookings@sunsetlagoon.boats>

# --- Media uploads (Cloudinary unsigned preset) ---
# Cloudinary Dashboard → Settings → Upload → Upload presets → create unsigned preset.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- Google reviews sync (Places API) ---
# 1. Google Cloud Console → enable "Places API" → create an API key (restrict it to Places API).
# 2. Paste the key below. Your Place ID is found automatically from your
#    business name — or set GOOGLE_PLACE_ID explicitly to skip the lookup.
GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=

# --- Legacy (no longer used; server functions replace the Laravel API) ---
# VITE_API_BASE_URL=
